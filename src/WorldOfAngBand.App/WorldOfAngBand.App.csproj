<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>WorldOfAngBand.App</RootNamespace>
    <!-- The executable is named after the repository, like the other AVA* games. -->
    <AssemblyName>AVAWorldOfAngBand</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!-- Publishing for a runtime (dotnet publish -r <rid>) gives one self-contained executable with the art inside. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WorldOfAngBand.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Flare art (CC-BY-SA 3.0, see Assets/Flare/LICENSE.txt) plus its sprite and tileset definitions. -->
    <AvaloniaResource Include="Assets\**" />
    <!-- AVABand's DCSS tiles (CC0), read through their manifest from beside the executable: the classic tile view, and
         the paper fallback for monsters with no Flare sprite. -->
    <Content Include="tilesets\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- The sound pack (the spec's section 8.1), made by tools/audio/make_audio_pack.py: music, ambience and effects
         from AVABand and AVAAshenReliquary, each file's source and licence in audio/CREDITS.md. -->
    <Content Include="audio\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Skia" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="SkiaSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WorldOfAngBand.Game\WorldOfAngBand.Game.csproj" />
    <ProjectReference Include="..\WorldOfAngBand.Audio\WorldOfAngBand.Audio.csproj" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Sound and music (the spec's section 8.1): AshenReliquary's copy of the OpenAL layer the AVA games share, with
    AVABand's sound packs. OpenAL Soft (via Silk.NET, with native libraries for Windows, Linux and macOS on x64/ARM)
    does the mixing; NVorbis and NLayer decode Ogg Vorbis and MP3 in managed code. It reads the session and never
    changes it.
  -->
  <PropertyGroup>
    <RootNamespace>WorldOfAngBand.Audio</RootNamespace>
    <!-- The OpenAL engine talks to OpenAL through pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Silk.NET.OpenAL" />
    <PackageReference Include="Silk.NET.OpenAL.Soft.Native" />
    <PackageReference Include="NVorbis" />
    <PackageReference Include="NLayer" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\WorldOfAngBand.Game\WorldOfAngBand.Game.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="WorldOfAngBand.Tests" />
    <InternalsVisibleTo Include="WorldOfAngBand.App.Tests" />
  </ItemGroup>
</Project>
